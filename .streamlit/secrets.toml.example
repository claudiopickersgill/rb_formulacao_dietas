# ============================================================
# CONFIGURAÇÃO COMPATÍVEL COM O REPOSITÓRIO ORIGINAL
# ============================================================
# Mantenha o seu URL atual. O código integrado reconhece esta chave.
private_gsheets_url = "https://docs.google.com/spreadsheets/d/SEU_ID/edit"

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# Primeira execução recomendada: Google Sheets + login local.
# Assim é possível validar o banco antes de configurar o login Google.
[app]
repository = "google_sheets"
auth_mode = "local"
local_email = "admin@local"
local_password = "TROQUE_ESTA_SENHA"
local_name = "Administrador"

[google_sheets]
# Também é possível informar spreadsheet_url ou spreadsheet_id aqui.
# Se ambos estiverem vazios, o app usa private_gsheets_url acima.
spreadsheet_url = ""
spreadsheet_id = ""

# As abas novas serão rb_ingredientes, rb_usuarios, rb_dietas etc.
# A primeira aba existente não será apagada.
table_prefix = "rb_"
cache_ttl_seconds = 60
max_retries = 5

# Copia automaticamente a tabela da primeira aba existente para
# rb_ingredientes, somente quando rb_ingredientes estiver vazia.
auto_migrate_legacy = true
legacy_worksheet_index = 0
legacy_worksheet_title = ""

# ============================================================
# LOGIN GOOGLE/OIDC — habilitar depois que o app estiver validado
# ============================================================
# Altere auth_mode acima para "oidc" e configure:
#
# [app]
# repository = "google_sheets"
# auth_mode = "oidc"
# oidc_provider = "google"
# bootstrap_admin_email = "seu-email@gmail.com"
#
# [auth]
# redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"
# cookie_secret = "CHAVE_ALEATORIA_LONGA"
#
# [auth.google]
# client_id = "CLIENT_ID_GOOGLE"
# client_secret = "CLIENT_SECRET_GOOGLE"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
